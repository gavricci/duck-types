{
  "name": "duck-types",
  "version": "0.1.0",
  "description": "Type-safe DuckDB client for TypeScript — row types inferred from your SQL, plain JS values out of the box.",
  "license": "MIT",
  "author": "Oleksandr Havrylov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavricci/duck-types.git"
  },
  "homepage": "https://github.com/gavricci/duck-types#readme",
  "bugs": "https://github.com/gavricci/duck-types/issues",
  "keywords": [
    "duckdb",
    "typescript",
    "sql",
    "typed",
    "type-safe",
    "analytics",
    "olap"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=2.0.0-r.1"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@biomejs/biome": "^2.6.2",
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "tinyglobby": "^0.2.17"
  },
  "bin": {
    "duck-types": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
